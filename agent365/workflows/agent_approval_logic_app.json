{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "2.0.0.0",
  "metadata": {
    "description": "Teams approval transport only. Python is the sole authority for request binding, authorization, expiry, idempotency, agent validation and Cosmos audit persistence.",
    "teamsOperationId": "PostCardAndWaitForResponse",
    "teamsConnectorReference": "https://learn.microsoft.com/en-us/connectors/teams/#post-adaptive-card-and-wait-for-a-response",
    "teamsContractVerification": "PostCardAndWaitForResponse path and nested body verified against eastus2 managedApis/teams?api-version=2016-06-01&export=true on 2026-09-09. The host connection supplies connectionId. Response fields are dynamic: responder.objectId (or responder.id), responder.tenantId, data.decision and data.comment. Missing or changed identity fields fail closed; verify when changing region or connector version.",
    "operationalConstraints": "Commercial-cloud Flow bot, authorized Teams OAuth connection, Workflows app allowed and a supported non-private channel. The first channel response completes the card; restrict channel membership to approvers. Python expiry remains the fallback after cancellation or exhausted callback retries.",
    "schemaValidation": "Request triggers and ParseJson actions do not support pattern or patternProperties. Use supported type, length, enum and exact routing/membership checks here. Python independently enforces UUID, hash, tenant and approver formats before persisting or accepting decisions."
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "teamsChannelId": { "type": "String" },
    "teamsGroupId": { "type": "String" },
    "approvalTimeoutHours": { "type": "Int" },
    "callbackUrl": { "type": "String" },
    "callbackAudience": { "type": "String" },
    "approverIds": { "type": "Array" },
    "approverTenantId": { "type": "String" }
  },
  "triggers": {
    "When_an_HTTP_request_is_received": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approval_id": { "type": "string", "minLength": 36, "maxLength": 36 },
            "request_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
            "task": { "type": "string", "minLength": 1, "maxLength": 8192 },
            "environment": { "type": "string", "minLength": 1, "maxLength": 128 },
            "requested_by": { "type": "string", "minLength": 1, "maxLength": 256 },
            "cluster": { "type": "string", "minLength": 1, "maxLength": 256 },
            "namespace": { "type": "string", "minLength": 1, "maxLength": 253 },
            "image_tags": {
              "type": "array",
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "commit_sha": { "type": ["string", "null"], "maxLength": 128 },
            "pipeline_url": { "type": ["string", "null"], "maxLength": 2048 },
            "rollback_url": { "type": ["string", "null"], "maxLength": 2048 },
            "request_timestamp": { "type": "string", "format": "date-time" },
            "expires_at": { "type": "string", "format": "date-time" },
            "approvers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              }
            }
          },
          "required": [
            "approval_id", "request_hash", "task", "environment", "requested_by",
            "cluster", "namespace", "image_tags", "commit_sha", "pipeline_url", "rollback_url",
            "request_timestamp", "expires_at", "approvers"
          ]
        }
      },
      "operationOptions": "EnableSchemaValidation",
      "runtimeConfiguration": {
        "secureData": { "properties": ["inputs", "outputs"] }
      }
    }
  },
  "actions": {
    "Acknowledge_Request": {
      "type": "Response",
      "kind": "Http",
      "runAfter": {},
      "inputs": {
        "statusCode": 202,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "approval_id": "@triggerBody()?['approval_id']",
          "workflow_run_id": "@workflow().run.name",
          "status": "accepted"
        }
      },
      "runtimeConfiguration": {
        "secureData": { "properties": ["inputs"] }
      }
    },
    "Validate_Deployment_Configuration": {
      "type": "ParseJson",
      "runAfter": { "Acknowledge_Request": ["Succeeded"] },
      "inputs": {
        "content": {
          "teamsChannelId": "@parameters('teamsChannelId')",
          "teamsGroupId": "@parameters('teamsGroupId')",
          "approvalTimeoutHours": "@parameters('approvalTimeoutHours')",
          "callbackUrl": "@parameters('callbackUrl')",
          "callbackAudience": "@parameters('callbackAudience')",
          "approverIds": "@parameters('approverIds')",
          "approverTenantId": "@parameters('approverTenantId')",
          "callbackUrlIsSafe": "@and(equals(uriScheme(parameters('callbackUrl')), 'https'), not(empty(uriHost(parameters('callbackUrl')))), or(equals(parameters('callbackUrl'), concat('https://', uriHost(parameters('callbackUrl')), '/agent-approvals/callback')), equals(parameters('callbackUrl'), concat('https://', uriHost(parameters('callbackUrl')), ':443/agent-approvals/callback'))))",
          "channelIsSupported": "@and(startsWith(parameters('teamsChannelId'), '19:'), or(endsWith(parameters('teamsChannelId'), '@thread.tacv2'), endsWith(parameters('teamsChannelId'), '@thread.skype')))",
          "audienceIsResourceUri": "@startsWith(parameters('callbackAudience'), 'api://')"
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "teamsChannelId": { "type": "string", "minLength": 16, "maxLength": 256 },
            "teamsGroupId": { "type": "string", "minLength": 36, "maxLength": 36 },
            "approvalTimeoutHours": { "type": "integer", "minimum": 1, "maximum": 24 },
            "callbackUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "callbackAudience": { "type": "string", "minLength": 42, "maxLength": 42 },
            "approverIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "type": "string", "minLength": 36, "maxLength": 36 }
            },
            "approverTenantId": { "type": "string", "minLength": 36, "maxLength": 36 },
            "callbackUrlIsSafe": { "type": "boolean", "enum": [true] },
            "channelIsSupported": { "type": "boolean", "enum": [true] },
            "audienceIsResourceUri": { "type": "boolean", "enum": [true] }
          },
          "required": ["teamsChannelId", "teamsGroupId", "approvalTimeoutHours", "callbackUrl", "callbackAudience", "approverIds", "approverTenantId", "callbackUrlIsSafe", "channelIsSupported", "audienceIsResourceUri"]
        }
      },
      "runtimeConfiguration": {
        "secureData": { "properties": ["inputs"] }
      }
    },
    "Collect_Decision": {
      "type": "Scope",
      "runAfter": { "Validate_Deployment_Configuration": ["Succeeded"] },
      "actions": {
        "Validate_Request_Identifiers": {
          "type": "ParseJson",
          "runAfter": {},
          "inputs": {
            "content": {
              "approval_id": "@triggerBody()?['approval_id']",
              "request_hash": "@triggerBody()?['request_hash']",
              "approvers": "@triggerBody()?['approvers']"
            },
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approval_id": { "type": "string", "minLength": 36, "maxLength": 36 },
                "request_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
                "approvers": {
                  "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
                  "items": { "type": "string", "minLength": 36, "maxLength": 36 }
                }
              },
              "required": ["approval_id", "request_hash", "approvers"]
            }
          },
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        },
        "Request_Is_Expired": {
          "type": "Compose",
          "runAfter": { "Validate_Request_Identifiers": ["Succeeded"] },
          "inputs": "@lessOrEquals(ticks(triggerBody()?['expires_at']), ticks(utcNow()))",
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        },
        "Validate_Request_Context": {
          "type": "ParseJson",
          "runAfter": { "Request_Is_Expired": ["Succeeded"] },
          "inputs": {
            "content": {
              "unexpired": "@not(outputs('Request_Is_Expired'))",
              "chronological": "@greater(ticks(triggerBody()?['expires_at']), ticks(triggerBody()?['request_timestamp']))",
              "has_eligible_approver": "@not(empty(intersection(json(toLower(string(parameters('approverIds')))), json(toLower(string(triggerBody()?['approvers']))))))"
            },
            "schema": {
              "type": "object",
              "properties": {
                "unexpired": { "type": "boolean", "enum": [true] },
                "chronological": { "type": "boolean", "enum": [true] },
                "has_eligible_approver": { "type": "boolean", "enum": [true] }
              },
              "required": ["unexpired", "chronological", "has_eligible_approver"]
            }
          },
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        },
        "Build_Adaptive_Card": {
          "type": "Compose",
          "runAfter": { "Validate_Request_Context": ["Succeeded"] },
          "inputs": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.4",
            "msteams": { "width": "Full" },
            "body": [
              { "type": "TextBlock", "text": "Deployment approval requested", "weight": "Bolder", "size": "Large", "wrap": true },
              { "type": "TextBlock", "text": "@triggerBody()?['task']", "wrap": true },
              {
                "type": "FactSet",
                "facts": [
                  { "title": "Approval ID", "value": "@triggerBody()?['approval_id']" },
                  { "title": "Request hash", "value": "@triggerBody()?['request_hash']" },
                  { "title": "Environment", "value": "@triggerBody()?['environment']" },
                  { "title": "Cluster", "value": "@triggerBody()?['cluster']" },
                  { "title": "Namespace", "value": "@triggerBody()?['namespace']" },
                  { "title": "Images", "value": "@join(triggerBody()?['image_tags'], ', ')" },
                  { "title": "Commit SHA", "value": "@coalesce(triggerBody()?['commit_sha'], '')" },
                  { "title": "Requested by", "value": "@triggerBody()?['requested_by']" },
                  { "title": "Requested at", "value": "@triggerBody()?['request_timestamp']" },
                  { "title": "Expires at", "value": "@triggerBody()?['expires_at']" }
                ]
              },
              { "type": "TextBlock", "text": "Only configured approvers may decide. Submitting this card does not authorize deployment: the Python engine verifies the request and records the outcome.", "wrap": true },
              { "type": "Input.Text", "id": "comment", "label": "Approval notes or rejection reason", "isMultiline": true, "maxLength": 2000 }
            ],
            "actions": [
              { "type": "Action.Submit", "title": "Approve", "style": "positive", "data": { "decision": "approved" } },
              { "type": "Action.Submit", "title": "Reject", "style": "destructive", "data": { "decision": "rejected" } }
            ]
          },
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        },
        "Wait_for_Teams_Response": {
          "type": "ApiConnectionWebhook",
          "runAfter": { "Build_Adaptive_Card": ["Succeeded"] },
          "inputs": {
            "host": {
              "connection": { "name": "@parameters('$connections')['teams']['connectionId']" }
            },
            "path": "/v1.0/teams/conversation/gatherinput/poster/Flow%20bot/location/Channel/$subscriptions",
            "body": {
              "notificationUrl": "@listCallbackUrl()",
              "body": {
                "recipient": {
                  "groupId": "@parameters('teamsGroupId')",
                  "channelId": "@parameters('teamsChannelId')"
                },
                "messageBody": "@string(outputs('Build_Adaptive_Card'))",
                "updateMessage": "Response received. The Python approval engine must still verify and record the outcome."
              }
            },
            "retryPolicy": { "type": "none" }
          },
          "limit": {
            "timeout": "@concat('PT', string(max(1, min(mul(parameters('approvalTimeoutHours'), 3600), div(sub(ticks(triggerBody()?['expires_at']), ticks(utcNow())), 10000000)))), 'S')"
          },
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs", "outputs"] }
          }
        },
        "Normalize_Submitted_Decision": {
          "type": "Compose",
          "runAfter": { "Wait_for_Teams_Response": ["Succeeded"] },
          "inputs": "@toLower(trim(string(coalesce(body('Wait_for_Teams_Response')?['data']?['decision'], ''))))",
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        },
        "Parse_Teams_Response": {
          "type": "ParseJson",
          "runAfter": { "Normalize_Submitted_Decision": ["Succeeded"] },
          "inputs": {
            "content": {
              "decision": "@if(contains(createArray('approve', 'approved'), outputs('Normalize_Submitted_Decision')), 'approved', if(contains(createArray('reject', 'rejected'), outputs('Normalize_Submitted_Decision')), 'rejected', 'error'))",
              "approved_by": "@toLower(string(coalesce(body('Wait_for_Teams_Response')?['responder']?['objectId'], body('Wait_for_Teams_Response')?['responder']?['id'], '')))",
              "approver_tenant_id": "@toLower(string(coalesce(body('Wait_for_Teams_Response')?['responder']?['tenantId'], '')))",
              "comment": "@string(coalesce(body('Wait_for_Teams_Response')?['data']?['comment'], ''))"
            },
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "decision": { "type": "string", "enum": ["approved", "rejected"] },
                "approved_by": { "type": "string", "minLength": 36, "maxLength": 36 },
                "approver_tenant_id": { "type": "string", "minLength": 36, "maxLength": 36 },
                "comment": { "type": "string", "maxLength": 2000 }
              },
              "required": ["decision", "approved_by", "approver_tenant_id", "comment"]
            }
          },
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        },
        "Responder_Is_Authorized": {
          "type": "Compose",
          "runAfter": { "Parse_Teams_Response": ["Succeeded"] },
          "inputs": "@and(contains(json(toLower(string(parameters('approverIds')))), body('Parse_Teams_Response')?['approved_by']), contains(json(toLower(string(triggerBody()?['approvers']))), body('Parse_Teams_Response')?['approved_by']), equals(body('Parse_Teams_Response')?['approver_tenant_id'], toLower(parameters('approverTenantId'))))",
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        },
        "Select_Terminal_Decision": {
          "type": "Compose",
          "runAfter": { "Responder_Is_Authorized": ["Succeeded"] },
          "inputs": "@if(outputs('Responder_Is_Authorized'), if(lessOrEquals(ticks(triggerBody()?['expires_at']), ticks(utcNow())), 'timeout', body('Parse_Teams_Response')?['decision']), 'error')",
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        },
        "Build_Decision_Callback": {
          "type": "Compose",
          "runAfter": { "Select_Terminal_Decision": ["Succeeded"] },
          "inputs": {
            "approval_id": "@triggerBody()?['approval_id']",
            "environment": "@triggerBody()?['environment']",
            "request_hash": "@triggerBody()?['request_hash']",
            "decision": "@outputs('Select_Terminal_Decision')",
            "approved_by": "@if(contains(createArray('approved', 'rejected'), outputs('Select_Terminal_Decision')), body('Parse_Teams_Response')?['approved_by'], 'system')",
            "approver_tenant_id": "@if(contains(createArray('approved', 'rejected'), outputs('Select_Terminal_Decision')), body('Parse_Teams_Response')?['approver_tenant_id'], '')",
            "comment": "@if(equals(outputs('Select_Terminal_Decision'), 'timeout'), 'Approval request expired before its response was processed.', if(equals(outputs('Select_Terminal_Decision'), 'error'), 'Teams responder is not an authorized approver for this request.', body('Parse_Teams_Response')?['comment']))",
            "workflow_run_id": "@workflow().run.name",
            "timestamp": "@utcNow()"
          },
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        }
      }
    },
    "Notify_Decision": {
      "type": "Scope",
      "runAfter": { "Collect_Decision": ["Succeeded"] },
      "actions": {
        "Send_Decision_Callback": {
          "type": "Http",
          "runAfter": {},
          "inputs": {
            "method": "POST",
            "uri": "@parameters('callbackUrl')",
            "headers": { "Content-Type": "application/json" },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "@parameters('callbackAudience')"
            },
            "body": "@outputs('Build_Decision_Callback')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "minimumInterval": "PT10S",
              "maximumInterval": "PT1M"
            }
          },
          "operationOptions": "DisableAsyncPattern",
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs", "outputs"] }
          }
        }
      }
    },
    "Handle_Timeout_Or_Error": {
      "type": "Scope",
      "runAfter": { "Collect_Decision": ["Failed", "TimedOut"] },
      "actions": {
        "Build_Failure_Callback": {
          "type": "Compose",
          "runAfter": {},
          "inputs": {
            "approval_id": "@triggerBody()?['approval_id']",
            "environment": "@triggerBody()?['environment']",
            "request_hash": "@triggerBody()?['request_hash']",
            "decision": "@if(or(equals(actions('Request_Is_Expired')?['outputs'], true), equals(actions('Wait_for_Teams_Response')?['status'], 'TimedOut'), equals(actions('Wait_for_Teams_Response')?['code'], 'ActionTimedOut')), 'timeout', 'error')",
            "approved_by": "system",
            "approver_tenant_id": "",
            "comment": "Approval transport timed out or failed; no human decision is being asserted.",
            "workflow_run_id": "@workflow().run.name",
            "timestamp": "@utcNow()"
          },
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          }
        },
        "Send_Failure_Callback": {
          "type": "Http",
          "runAfter": { "Build_Failure_Callback": ["Succeeded"] },
          "inputs": {
            "method": "POST",
            "uri": "@parameters('callbackUrl')",
            "headers": { "Content-Type": "application/json" },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "@parameters('callbackAudience')"
            },
            "body": "@outputs('Build_Failure_Callback')",
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "minimumInterval": "PT10S",
              "maximumInterval": "PT1M"
            }
          },
          "operationOptions": "DisableAsyncPattern",
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs", "outputs"] }
          }
        }
      }
    },
    "Stop_On_Invalid_Configuration": {
      "type": "Terminate",
      "runAfter": { "Validate_Deployment_Configuration": ["Failed", "TimedOut"] },
      "inputs": {
        "runStatus": "Failed",
        "runError": {
          "code": "InvalidApprovalTransportConfiguration",
          "message": "Approval routing is not valid. No outbound request was sent. Python must expire the pending approval."
        }
      }
    }
  },
  "outputs": {}
}
