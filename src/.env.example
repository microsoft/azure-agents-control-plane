# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=

# Microsoft Agent Framework / Azure AI Foundry Configuration
# Required for AI Agent capabilities
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.api.azureml.ms
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure Agents Learning SDK (in-process reinforcement learning)
# https://github.com/microsoft/azure-agents-learning-sdk
# Storage backend for episodes/rewards/policies: memory | local | cosmos
AGENT_LEARNING_STORE_BACKEND=memory
AGENT_LEARNING_AGENT_ID=mcp-agents
# Set to true to capture agent interactions as learning episodes
AGENT_LEARNING_ENABLE_CAPTURE=false
# Cosmos DB persistence (only used when AGENT_LEARNING_STORE_BACKEND=cosmos)
AGENT_LEARNING_COSMOS_ENDPOINT=
AGENT_LEARNING_COSMOS_DATABASE=agent_learning
# Azure AI Evaluation judge used to score episodes (optional; scoring is skipped if unset)
AGENT_LEARNING_JUDGE_ENDPOINT=
AGENT_LEARNING_JUDGE_DEPLOYMENT=
